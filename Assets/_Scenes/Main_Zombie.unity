--- !u!114 &1796066524
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1796066518}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 05e3a71baaf4b46428d734bb6ec5a573, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
  - name: R1
    sentences:
    - "\u0412\u044B \u043D\u0430\u0448\u043B\u0438 \u0440\u0430\u0434\u0438\u043E\u0441\u0442\u0430\u043D\u0446\u0438\u044E,
      \u043D\u043E \u043E\u043D\u0430 \u043F\u043E\u043B\u043E\u043C\u0430\u043D\u0430. 
      \u0414\u043B\u044F \u043F\u043E\u0447\u0438\u043D\u043A\u0438 \u043F\u043E\u0442\u0440\u0435\u0431\u0443\u044E\u0442\u0441\u044F
      \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u044B, \u0440\u0430\u0434\u0438\u043E\u0434\u0435\u0442\u0430\u043B\u0438
      \u0438 \u043A\u0430\u0431\u0435\u043B\u044C.\n\n- \u0418\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u044B
      \u043C\u043E\u0436\u043D\u043E \u043D\u0430\u0439\u0442\u0438 \u0432 \u0441\u0443\u043F\u0435\u0440\u043C\u0430\u0440\u043A\u0435\u0442\u0435
      \u0432 \u0446\u0435\u043D\u0442\u0440\u0435 \u0433\u043E\u0440\u043E\u0434\u0430.\n\n-
      \u0420\u0430\u0434\u0438\u043E\u0434\u0435\u0442\u0430\u043B\u0438 \u043C\u043E\u0436\u043D\u043E
      \u0438\u0437\u0432\u043B\u0435\u0447\u044C \u0438\u0437 \u043D\u0435\u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0449\u0438\u0439
      \u0440\u0430\u0434\u0438\u043E\u0441\u0442\u0430\u043D\u0446\u0438\u0439 \u043D\u0430
      \u0432\u043E\u0435\u043D\u043D\u043E\u043C \u0447\u0430\u0441\u0442\u0438 \u0432
      \u0441\u0435\u0432\u0435\u0440\u043E-\u0437\u0430\u043F\u0430\u0434\u043D\u043E\u0439
      \u0447\u0430\u0441\u0442\u0438 \u0433\u043E\u0440\u043E\u0434\u0430.\n\n- \u041A\u0430\u0431\u0435\u043B\u044C
      \u043C\u043E\u0436\u043D\u043E \u043D\u0430\u0439\u0442\u0438 \u043D\u0430
      \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u043C \u0441\u043A\u043B\u0430\u0434\u0435
      \u0432 \u044E\u0433\u043E-\u0432\u043E\u0441\u0442\u043E\u0447\u043D\u043E\u0439
      \u0447\u0430\u0441\u0442\u0438 \u0433\u043E\u0440\u043E\u0434\u0430. "
  - name: R2
    sentences:
    - "\u0412\u044B \u043F\u043E\u0447\u0438\u043D\u0438\u043B\u0438 \u0440\u0430\u0434\u0438\u043E\u0441\u0442\u0430\u043D\u0446\u0438\u044E
      \u0438 \u0441\u0432\u044F\u0437\u0430\u043B\u0438\u0441\u044C \u0441 \u0432\u043E\u0435\u043D\u043D\u044B\u043C\u0438.
      \u0414\u043B\u044F \u0432\u0430\u0448\u0435\u0433\u043E \u0441\u043F\u0430\u0441\u0435\u043D\u0438\u044F
      \u0432\u044B\u0441\u043B\u0430\u043B\u0438 \u0432\u0435\u0440\u0442\u043E\u043B\u0451\u0442,
      \u043D\u043E \u0435\u043C\u0443 \u043D\u0443\u0436\u043D\u043E \u0431\u0443\u0434\u0435\u0442
      \u0440\u0430\u0437\u0433\u043B\u044F\u0434\u0435\u0442\u044C \u0432\u0430\u0441
      \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0435, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
      \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F \u043C\u043E\u0449\u043D\u044B\u0439
      \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A \u0441\u0432\u0435\u0442\u0430.
      \n\u0421\u0443\u0434\u044F \u043F\u043E \u043A\u0430\u0440\u0442\u0430\u043C
      \u0432 \u0441\u0435\u0432\u0435\u0440\u043E - \u0432\u043E\u0441\u0442\u043E\u0447\u043D\u043E\u0439
      \u0447\u0430\u0441\u0442\u0438 \u0433\u043E\u0440\u043E\u0434\u0430 \u0435\u0441\u0442\u044C
      \u0432\u0435\u0440\u0442\u043E\u043B\u0451\u0442\u043D\u0430\u044F \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0430.
      \u041D\u0430\u0439\u0434\u0438\u0442\u0435 \u044D\u0442\u0443 \u0432\u0435\u0440\u0442\u043E\u043B\u0451\u0442\u043D\u0443\u044E
      \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0443 \u0438 \u0432\u043A\u043B\u044E\u0447\u0438\u0442\u0435
      \u043D\u0430 \u043D\u0435\u0439 \u043F\u0440\u043E\u0436\u0435\u043A\u0442\u043E\u0440\u044B."
