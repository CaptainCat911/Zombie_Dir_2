--- !u!114 &1099635158
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1099635155}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 05e3a71baaf4b46428d734bb6ec5a573, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
  - name: "\u0421\u0422\u0410\u0420\u0422"
    sentences:
    - "149 \u0434\u0435\u043D\u044C \u0437\u0430\u0440\u0430\u0436\u0435\u043D\u0438\u044F.
      \n\n\u0412\u044B \u0441\u043F\u0430\u0441\u043B\u0438\u0441\u044C \u0438\u0437
      \u043C\u0435\u0433\u0430\u043F\u043E\u043B\u0438\u0441\u0430 \u0438 \u043F\u0440\u0438\u0431\u044B\u043B\u0438
      \u0432 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0433\u043E\u0440\u043E\u0434\u043E\u043A.
      \u0412\u0430\u043C \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
      \u0441\u0432\u044F\u0437\u0430\u0442\u044C\u0441\u044F \u0441 \u0432\u043E\u0435\u043D\u043D\u044B\u043C\u0438,
      \u0447\u0442\u043E\u0431\u044B \u0432\u0430\u0441 \u0441\u043F\u0430\u0441\u043B\u0438.
      \u0423 \u0432\u0430\u0441 \u0435\u0441\u0442\u044C \u043A\u0430\u0440\u0442\u0430,
      \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u0432\u044B \u043E\u0442\u043C\u0435\u0442\u0438\u043B\u0438
      \u043D\u0430\u0438\u0431\u043E\u043B\u0435\u0435 \u0432\u0430\u0436\u043D\u044B\u0435
      \u043E\u0431\u044A\u0435\u043A\u0442\u044B \u0432 \u0433\u043E\u0440\u043E\u0434\u0435.
      \u0412 \u044E\u0433\u043E-\u0437\u0430\u043F\u0430\u0434\u043D\u043E\u0439
      \u0447\u0430\u0441\u0442\u0438 \u0433\u043E\u0440\u043E\u0434\u0430 \u0435\u0441\u0442\u044C
      \u0440\u0430\u0434\u0438\u043E\u0432\u044B\u0448\u043A\u0430 - \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u0439\u0442\u0435\u0441\u044C
      \u0442\u0443\u0434\u0430 \u0438 \u043D\u0430\u0439\u0434\u0438\u0442\u0435
      \u0440\u0430\u0434\u0438\u043E\u0441\u0442\u0430\u043D\u0446\u0438\u044E !"
    - "\u0412\u0430\u0448\u0430 \u0446\u0435\u043B\u044C \u0432\u044B\u0436\u0438\u0442\u044C.\n\u0427\u0435\u043C
      \u0434\u043E\u043B\u044C\u0448\u0435 \u0432\u044B \u043E\u0441\u0442\u0430\u0451\u0442\u0435\u0441\u044C
      \u0432 \u0433\u043E\u0440\u043E\u0434\u0435, \u0442\u0435\u043C \u0431\u043E\u043B\u044C\u0448\u0435
      \u0438\u0445 \u043F\u0440\u0438\u0434\u0451\u0442. \u0418\u043C \u043D\u0435\u0442
      \u0447\u0438\u0441\u043B\u0430. \n\u0412\u0435\u0447\u043D\u043E \u0433\u043E\u043B\u043E\u0434\u043D\u044B\u0435,
      \u043D\u0430\u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443 \u0436\u0438\u0432\u044B\u0435,
      \u043D\u0430\u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443 \u043C\u0451\u0440\u0442\u0432\u044B\u0435,
      \u043E\u043D\u0438 \u0443\u0436\u0435 \u0438\u0434\u0443\u0442 \u0437\u0430
      \u0432\u0430\u043C\u0438..."
    - "\u041F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430 \u043F\u043E \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044E
      \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0432 \u043C\u0435\u043D\u044E
      \u043F\u0430\u0443\u0437\u044B \u0432\u043E \u0432\u043A\u043B\u0430\u0434\u043A\u0435
      \"\u0423\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435\" "
  - name: "\u0424\u0418\u041D\u0418\u0428"
    sentences:
    - "\u0412\u044B \u0432\u044B\u0436\u0438\u043B\u0438 !"
